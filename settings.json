{
  /** ------------ Workbench Settings ------------ **/
  "workbench.colorCustomizations": {
    "scrollbar.shadow": "#24292e00"
  },
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.editorLargeFileConfirmation": 10024,
  "workbench.layoutControl.enabled": false,
  "workbench.editor.showTabs": "single",
  "workbench.tree.indent": 16,
  "workbench.startupEditor": "none",
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.editor.empty.hint": "hidden",
  "breadcrumbs.symbolPath": "off",
  "breadcrumbs.filePath": "on",
  "explorer.compactFolders": false,

  /** ------------ Editor Settings ------------ **/
  "editor.fontFamily": "'Fira Code Retina', 'Hack Nerd Font', Monospace",
  "editor.fontSize": 16,
  "editor.fontWeight": 500,
  "editor.lineHeight": 26,
  "editor.lineNumbers": "on",
  "editor.folding": true,
  "editor.glyphMargin": true,
  "editor.guides.indentation": false,
  "editor.scrollbar.horizontal": "hidden",
  "editor.unicodeHighlight.ambiguousCharacters": false,
  "editor.unicodeHighlight.invisibleCharacters": false,
  "editor.cursorStyle": "underline",
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.stickyScroll.enabled": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.cursorWidth": 3,
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.linkedEditing": true,

  /** ------------ Terminal Configurations ------------ **/
  "terminal.integrated.defaultProfile.windows": "Git Bash",
  "terminal.integrated.fontFamily": "'MesloLGS NF', 'Hack Nerd Font', Monospace",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.enableMultiLinePasteWarning": "never",
  "terminal.integrated.cursorStyle": "underline",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.initialHint": false,

  /** ------------ Additional Configurations ------------ **/
  "vscode_custom_css.imports": [
    // Replace YOUR_USERNAME with your operating system username.
    "file:///C:/Users/YOUR_USERNAME/.vscode/vscode-custom/style.css",
    "file:///C:/Users/YOUR_USERNAME/.vscode/vscode-custom/script.js"
  ],
  "files.autoSave": "afterDelay",
  "telemetry.telemetryLevel": "off"
}
